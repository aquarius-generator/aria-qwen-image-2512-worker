    "presets": [
      {
        "name": "Bake-off default",
        "defaults": {
          "QWEN_MODEL_ID": "Qwen/Qwen-Image-2512",
          "QWEN_MODEL_REVISION": "25468b98e3276ca6700de15c6628e51b7de54a26"
        }
      }
    ]
  }
}
